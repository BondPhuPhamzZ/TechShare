@model IEnumerable<TechShare.Models.Rental>

<style>
    .timeline-step {
        position: relative;
        z-index: 2;
        background-color: white;
        padding: 0 10px;
        text-align: center;
        min-width: 80px;
    }
    .timeline-icon {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 5px auto;
        font-size: 1.2rem;
    }
    .timeline-bar {
        position: absolute;
        top: 17px;
        left: 5%;
        width: 90%;
        height: 4px;
        background-color: #e9ecef;
        z-index: 1;
    }
    .timeline-progress {
        height: 100%;
        background-color: #4f46e5; 
        transition: width 0.5s ease;
    }
</style>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted bg-white rounded border border-dashed">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mt-2">Không có đơn hàng nào trong mục này.</p>
    </div>
}
else
{
    @foreach (var rental in Model)
    {
        int progress = 0;
        int statusLevel = 0;
        if (rental.Status == TechShare.Enums.RentalStatus.ChoDuyet) { progress = 0; statusLevel = 0; }
        else if (rental.Status == TechShare.Enums.RentalStatus.DaDuyet) { progress = 33; statusLevel = 1; }
        else if (rental.Status == TechShare.Enums.RentalStatus.DangGiao) { progress = 66; statusLevel = 2; }
        else if (rental.Status == TechShare.Enums.RentalStatus.DangThue || rental.Status == TechShare.Enums.RentalStatus.ChoTra || rental.Status == TechShare.Enums.RentalStatus.TranhChap) { progress = 100; statusLevel = 3; }
        else if (rental.Status == TechShare.Enums.RentalStatus.HoanTat) { progress = 100; statusLevel = 4; }
        else if (rental.Status == TechShare.Enums.RentalStatus.DaHuy) { progress = 100; statusLevel = -1; }

        <div class="card shadow-sm border-0 mb-4 rounded-3">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-secondary me-2">#@rental.Id</span>
                    <small class="text-muted"><i class="bi bi-calendar3"></i> @rental.StartDate.ToString("dd/MM/yyyy") - <strong class="text-danger">@rental.EndDate.ToString("dd/MM/yyyy")</strong></small>
                </div>
                <div>
                    <span class="badge @(GetBadge(rental.Status)) fs-6 px-3 py-2">@(GetStatus(rental.Status))</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row align-items-center mb-4">
                    <div class="col-md-5 d-flex align-items-center mb-3 mb-md-0">
                        <img src="@rental.Device.ImageUrl" style="width: 80px; height: 80px; object-fit: cover;" class="rounded border me-3 shadow-sm" />
                        <div>
                            <h5 class="mb-1"><a asp-controller="Device" asp-action="Detail" asp-route-id="@rental.Device.Id" class="text-dark text-decoration-none fw-bold">@rental.Device.Name</a></h5>
                            <div class="text-muted small">Số lượng: <strong>@rental.Quantity cái</strong></div>
                            <div class="text-muted small">Giao hàng: <strong>@(rental.DeliveryMethod == TechShare.Enums.DeliveryMethod.GiaoTanNoi ? "Giao tận nơi" : "Tự đến lấy")</strong></div>
                        </div>
                    </div>
                    
                    <div class="col-md-7">
                        @if (statusLevel >= 0 && statusLevel <= 3)
                        {
                            <div class="position-relative mt-2 mb-2">

                                <div class="timeline-bar">
                                    <div class="timeline-progress" style="width: @(progress)%"></div>
                                </div>

                                <div class="d-flex justify-content-between position-relative z-index-2">
                                    <div class="timeline-step">
                                        <div class="timeline-icon @(statusLevel >= 0 ? "bg-primary text-white shadow-sm" : "bg-light text-muted border")">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </div>
                                        <div class="small @(statusLevel >= 0 ? "fw-bold text-primary" : "text-muted")">Chờ Duyệt</div>
                                    </div>

                                    <div class="timeline-step">
                                        <div class="timeline-icon @(statusLevel >= 1 ? "bg-primary text-white shadow-sm" : "bg-light text-muted border")">
                                            <i class="bi bi-check-circle"></i>
                                        </div>
                                        <div class="small @(statusLevel >= 1 ? "fw-bold text-primary" : "text-muted")">Đã Duyệt</div>
                                    </div>

                                    <div class="timeline-step">
                                        <div class="timeline-icon @(statusLevel >= 2 ? "bg-primary text-white shadow-sm" : "bg-light text-muted border")">
                                            <i class="bi bi-truck"></i>
                                        </div>
                                        <div class="small @(statusLevel >= 2 ? "fw-bold text-primary" : "text-muted")">Đang Giao</div>
                                    </div>

                                    <div class="timeline-step">
                                        <div class="timeline-icon @(statusLevel >= 3 ? "bg-primary text-white shadow-sm" : "bg-light text-muted border")">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                        <div class="small @(statusLevel >= 3 ? "fw-bold text-primary" : "text-muted")">Đang Thuê</div>
                                    </div>

                                </div>
                            </div>
                        }
                        else if (statusLevel == 4)
                        {
                            <div class="alert alert-success text-center mb-0 py-2"><i class="bi bi-check-circle-fill me-2"></i> Đơn hàng đã hoàn tất. Cảm ơn bạn!</div>
                        }
                        else
                        {
                            <div class="alert alert-danger text-center mb-0 py-2"><i class="bi bi-x-circle-fill me-2"></i> Đơn hàng đã bị hủy.</div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-end align-items-center border-top pt-3 mt-2">
                    <div class="me-auto">
                        <span class="text-muted small">Tổng tiền:</span>
                        <strong class="text-danger fs-5 ms-1">@rental.TotalPrice.ToString("N0") đ</strong>
                    </div>

                    @if (rental.Status == TechShare.Enums.RentalStatus.DangThue)
                    {
                        bool isWithin2Hours = rental.ShipTime.HasValue && DateTime.Now <= rental.ShipTime.Value.AddHours(2);
                        
                        if (isWithin2Hours)
                        {
                            <form asp-controller="Order" asp-action="ReportIssue" method="post" class="d-inline me-2">
                                <input type="hidden" name="id" value="@rental.Id" />
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Bạn phát hiện máy có lỗi? Đơn sẽ bị khóa để Shop kiểm tra và giải quyết.')"><i class="bi bi-exclamation-triangle"></i> Báo Lỗi</button>
                            </form>
                        }
                        <form asp-controller="Order" asp-action="ReturnDevice" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@rental.Id" />
                            <button type="submit" class="btn btn-warning" onclick="return confirm('CẢNH BÁO: Trả máy sớm hơn thời hạn vẫn sẽ bị tính nguyên phí thuê. Bạn có chắc chắn muốn báo trả máy?')"><i class="bi bi-arrow-return-left"></i> Trả Máy (Sớm)</button>
                        </form>
                    }
                    else if (rental.Status == TechShare.Enums.RentalStatus.HoanTat)
                    {
                        if (!rental.IsReviewed)
                        {
                            <a asp-controller="Review" asp-action="Create" asp-route-rentalId="@rental.Id" class="btn btn-outline-warning"><i class="bi bi-star-fill"></i> Đánh giá Sản phẩm</a>
                        }
                        else
                        {
                            <span class="btn btn-secondary disabled"><i class="bi bi-check-lg"></i> Đã đánh giá</span>
                        }
                    }
                    else if (rental.Status == TechShare.Enums.RentalStatus.ChoDuyet || rental.Status == TechShare.Enums.RentalStatus.DaDuyet || rental.Status == TechShare.Enums.RentalStatus.DangGiao)
                    {
                        <span class="text-muted small italic">Vui lòng chờ shop xử lý...</span>
                    }
                    else if (rental.Status == TechShare.Enums.RentalStatus.TranhChap)
                    {
                        <span class="text-danger fw-bold"><i class="bi bi-shield-exclamation"></i> Shop đang liên hệ để kiểm tra lỗi...</span>
                    }
                </div>
            </div>
        </div>
    }
}

@functions {
    public string GetStatus(TechShare.Enums.RentalStatus status)
    {
        return status switch
        {
            TechShare.Enums.RentalStatus.ChoDuyet => "Chờ duyệt",
            TechShare.Enums.RentalStatus.DaDuyet => "Đã duyệt",
            TechShare.Enums.RentalStatus.DangGiao => "Đang giao máy",
            TechShare.Enums.RentalStatus.DangThue => "Đang Thuê",
            TechShare.Enums.RentalStatus.ChoTra => "Chờ kiểm tra trả",
            TechShare.Enums.RentalStatus.HoanTat => "Hoàn Tất",
            TechShare.Enums.RentalStatus.DaHuy => "Đã Hủy",
            TechShare.Enums.RentalStatus.TranhChap => "Chờ xử lý sự cố",
            _ => "Không xác định"
        };
    }

    public string GetBadge(TechShare.Enums.RentalStatus status)
    {
        return status switch
        {
            TechShare.Enums.RentalStatus.ChoDuyet => "bg-warning text-dark",
            TechShare.Enums.RentalStatus.DaDuyet => "bg-info text-dark",
            TechShare.Enums.RentalStatus.DangThue => "bg-primary",
            TechShare.Enums.RentalStatus.HoanTat => "bg-success",
            TechShare.Enums.RentalStatus.TranhChap => "bg-danger",
            TechShare.Enums.RentalStatus.DaHuy => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}
