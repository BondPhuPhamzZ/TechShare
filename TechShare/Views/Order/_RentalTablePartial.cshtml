@model IEnumerable<TechShare.Models.Rental>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Thiết bị</th>

                        <th>Ngày mượn - Ngày trả</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">Không có đơn nào trong mục này.</td></tr>
                    }
                    else
                    {
                        @foreach (var rental in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@rental.Id</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@rental.Device.ImageUrl" style="width: 50px; height: 50px; object-fit: cover;" class="rounded me-3" />
                                        <div>
                                            <a asp-controller="Device" asp-action="Detail" asp-route-id="@rental.Device.Id" class="fw-bold text-decoration-none">@rental.Device.Name</a>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div>@rental.StartDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-danger fw-bold">@rental.EndDate.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <!-- Timeline Tiến Độ -->
                                    <div class="small fw-bold text-muted mb-1">Tiến độ đơn hàng:</div>
                                    <div class="d-flex align-items-center mb-2">
                                        @if (rental.Status == TechShare.Enums.RentalStatus.DaHuy)
                                        {
                                            <span class="badge bg-danger">Đã Hủy Đơn</span>
                                        }
                                        else if (rental.Status == TechShare.Enums.RentalStatus.HoanTat)
                                        {
                                            <span class="badge bg-dark">Đã Hoàn Tất</span>
                                        }
                                        else
                                        {
                                            <span class="badge @(rental.Status >= TechShare.Enums.RentalStatus.ChoDuyet ? "bg-primary" : "bg-secondary text-muted") me-1">Chờ Duyệt</span>
                                            <i class="bi bi-chevron-right text-muted small"></i>
                                            <span class="badge @(rental.Status >= TechShare.Enums.RentalStatus.DaDuyet ? "bg-primary" : "bg-secondary text-muted") mx-1">Đã Duyệt</span>
                                            
                                            @if (rental.DeliveryMethod == TechShare.Enums.DeliveryMethod.GiaoTanNoi)
                                            {
                                                <i class="bi bi-chevron-right text-muted small"></i>
                                                <span class="badge @(rental.Status >= TechShare.Enums.RentalStatus.DangGiao ? "bg-info text-dark" : "bg-secondary text-muted") mx-1">Đang Giao</span>
                                            }

                                            <i class="bi bi-chevron-right text-muted small"></i>
                                            <span class="badge @(rental.Status == TechShare.Enums.RentalStatus.DangThue ? "bg-success" : "bg-secondary text-muted") ms-1">Đang Thuê</span>
                                        }
                                    </div>
                                    <span class="badge @(GetBadge(rental.Status)) mt-1">Trạng thái hiện tại: @(GetStatus(rental.Status))</span>
                                </td>
                                <td class="text-end">
                                    @if (rental.Status == TechShare.Enums.RentalStatus.DangThue)
                                    {
                                        // Kiểm tra 2 giờ tính từ lúc Shop giao (ShipTime)
                                        bool isWithin2Hours = rental.ShipTime.HasValue && DateTime.Now <= rental.ShipTime.Value.AddHours(2);
                                        
                                        if (isWithin2Hours)
                                        {
                                            <form asp-controller="Order" asp-action="ReportIssue" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@rental.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger mb-1" onclick="return confirm('Bạn phát hiện máy có lỗi? Đơn sẽ bị khóa để Shop kiểm tra.')">Báo Lỗi</button>
                                            </form>
                                        }
                                        <form asp-controller="Order" asp-action="ReturnDevice" method="post" class="d-inline ms-1">
                                            <input type="hidden" name="id" value="@rental.Id" />
                                            <button type="submit" class="btn btn-sm btn-warning mb-1" onclick="return confirm('CẢNH BÁO: Trả máy sớm hơn thời hạn vẫn sẽ bị tính nguyên phí thuê. Bạn có chắc chắn muốn báo trả máy?')">Trả Máy (Sớm)</button>
                                        </form>
                                    }
                                    else if (rental.Status == TechShare.Enums.RentalStatus.HoanTat)
                                    {
                                        if (!rental.IsReviewed)
                                        {
                                            <a asp-controller="Review" asp-action="Create" asp-route-rentalId="@rental.Id" class="btn btn-sm btn-outline-warning">Đánh giá Sản phẩm</a>
                                        }
                                        else
                                        {
                                            <span class="btn btn-sm btn-secondary disabled">Đã đánh giá</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    public string GetStatus(TechShare.Enums.RentalStatus status)
    {
        return status switch
        {
            TechShare.Enums.RentalStatus.ChoDuyet => "Chờ duyệt",
            TechShare.Enums.RentalStatus.DaDuyet => "Đã duyệt",
            TechShare.Enums.RentalStatus.DangGiao => "Đang giao máy",
            TechShare.Enums.RentalStatus.DangThue => "Đang Thuê",
            TechShare.Enums.RentalStatus.ChoTra => "Chờ kiểm tra trả",
            TechShare.Enums.RentalStatus.HoanTat => "Hoàn Tất",
            TechShare.Enums.RentalStatus.DaHuy => "Đã Hủy",
            TechShare.Enums.RentalStatus.TranhChap => "Đang Tranh Chấp",
            _ => "Không xác định"
        };
    }

    public string GetBadge(TechShare.Enums.RentalStatus status)
    {
        return status switch
        {
            TechShare.Enums.RentalStatus.ChoDuyet => "bg-warning text-dark",
            TechShare.Enums.RentalStatus.DaDuyet => "bg-info text-dark",
            TechShare.Enums.RentalStatus.DangThue => "bg-primary",
            TechShare.Enums.RentalStatus.HoanTat => "bg-success",
            TechShare.Enums.RentalStatus.TranhChap => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
