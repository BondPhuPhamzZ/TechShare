@model TechShare.Models.Rental
@{
    Layout = null; // Hoá đơn không cần dùng layout chung (để in đẹp nhất)
    decimal phuPhiTreHan = (Model.Status == TechShare.Enums.RentalStatus.HoanTat && Model.LateFee > 0) ? Model.LateFee : 0;
    decimal tongTienDichVu = Model.TotalPrice - phuPhiTreHan;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hóa Đơn #@Model.Id - TechShare</title>
    <!-- Sử dụng Bootstrap cho Table -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
        }
        .invoice-container {
            max-width: 800px;
            margin: 40px auto;
            background: #fff;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .brand-name {
            color: #0d6efd;
            font-weight: 800;
            font-size: 2rem;
            margin-bottom: 0;
        }
        .invoice-title {
            text-transform: uppercase;
            font-weight: 700;
            color: #495057;
            letter-spacing: 2px;
        }
        .table-invoice th {
            background-color: #f1f3f5;
            color: #495057;
        }
        .total-row {
            background-color: #0d6efd !important;
            color: white !important;
            font-size: 1.25rem;
            font-weight: bold;
        }
        .total-row td {
            color: white !important;
        }
        .no-print {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        /* Khi bấm IN (Ctrl+P), ẩn hết UI thừa, bỏ margin, đổ nền trắng hoàn toàn */
        @@media print {
            body {
                background-color: #fff !important;
                margin: 0;
                padding: 0;
            }
            .invoice-container {
                margin: 0;
                padding: 0;
                box-shadow: none;
                max-width: 100%;
            }
            .no-print {
                display: none !important;
            }
            .total-row {
                background-color: #f8f9fa !important;
                color: #000 !important;
                -webkit-print-color-adjust: exact;
            }
            .total-row td {
                color: #000 !important;
            }
        }
    </style>
</head>
<body>

<div class="no-print mt-4">
    <button onclick="window.print()" class="btn btn-primary btn-lg px-4 shadow-sm">
        <i class="bi bi-printer me-2"></i> Xuất PDF / In Phiếu
    </button>
    <button onclick="history.back()" class="btn btn-outline-secondary btn-lg px-4 shadow-sm">
        Quay lại
    </button>
</div>

<div class="invoice-container">
    <!-- Header Hóa Đơn -->
    <div class="row mb-5 align-items-center">
        <div class="col-sm-6 text-center text-sm-start mb-4 mb-sm-0">
            <h1 class="brand-name">TECHSHARE</h1>
            <p class="text-muted mb-0">Nền tảng chia sẻ thiết bị công nghệ hàng đầu</p>
            <p class="text-muted mb-0">Email: support@techshare.vn | Hotline: 1900 1234</p>
        </div>
        <div class="col-sm-6 text-center text-sm-end">
            <h2 class="invoice-title mb-2">HÓA ĐƠN ĐIỆN TỬ</h2>
            <p class="fw-bold mb-0 fs-5 text-primary">Mã Hóa Đơn: #@Model.Id.ToString("D5")</p>
            <p class="text-muted">Ngày lập: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>

    <!-- Thông tin Khách hàng -->
    <div class="row mb-4">
        <div class="col-12">
            <h5 class="fw-bold border-bottom pb-2 mb-3 text-secondary">THÔNG TIN KHÁCH HÀNG</h5>
            <table class="table table-borderless table-sm w-100">
                <tbody>
                    <tr>
                        <td style="width: 150px;" class="fw-bold text-muted">Họ và tên:</td>
                        <td class="fs-5 fw-semibold">@Model.Renter?.FullName</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-muted">Email liên hệ:</td>
                        <td>@Model.Renter?.Email</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-muted">Số điện thoại:</td>
                        <td>@Model.Renter?.PhoneNumber</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Bảng chi tiết dịch vụ -->
    <h5 class="fw-bold border-bottom pb-2 mb-3 text-secondary mt-5">CHI TIẾT DỊCH VỤ THUÊ</h5>
    <div class="table-responsive">
        <table class="table table-bordered table-invoice align-middle">
            <thead>
                <tr class="text-center">
                    <th>Mã Thiết Bị</th>
                    <th class="text-start">Tên Thiết Bị / Dịch vụ</th>
                    <th>Hình Thức Nhận</th>
                    <th>Ngày Thuê</th>
                    <th>Ngày Trả</th>
                    <th class="text-end">Thành Tiền (VNĐ)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center">#@Model.DeviceId</td>
                    <td class="fw-semibold">@Model.Device?.Name</td>
                    <td class="text-center">@(Model.DeliveryMethod == TechShare.Enums.DeliveryMethod.TuLay ? "Tại cửa hàng" : "Giao hàng")</td>
                    <td class="text-center">@Model.StartDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">@Model.EndDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@tongTienDichVu.ToString("N0")</td>
                </tr>
                @if (phuPhiTreHan > 0)
                {
                    <tr>
                        <td colspan="5" class="text-end fw-semibold text-primary">Phụ phí trễ hạn (Đã tính tự động vào tổng tiền)</td>
                        <td class="text-end text-primary">+ @phuPhiTreHan.ToString("N0")</td>
                    </tr>
                }
                <!-- Hàng Tổng Tiền -->
                <tr class="total-row">
                    <td colspan="5" class="text-end text-uppercase">TỔNG CỘNG ĐÃ THANH TOÁN</td>
                    <td class="text-end fs-4">@Model.TotalPrice.ToString("N0") đ</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Footer Hóa Đơn -->
    <div class="row mt-5 pt-4 border-top">
        <div class="col-12 text-center text-muted">
            <p class="mb-1">Cảm ơn quý khách đã tin tưởng và sử dụng dịch vụ của TechShare!</p>
            <p class="small">Chứng từ này có giá trị xác nhận thanh toán điện tử tương đương với hóa đơn giấy.</p>
        </div>
    </div>
</div>

<script>
    // Tự động bật hộp thoại in khi vừa load trang
    window.onload = function() {
        setTimeout(function() {
            window.print();
        }, 500); // Đợi 0.5s để load style
    };
</script>
</body>
</html>
