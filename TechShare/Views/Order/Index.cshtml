@model TechShare.ViewModels.OrderViewModel
@{
    ViewData["Title"] = "Đơn đi thuê của tôi";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-bag-check"></i> Đơn Đi Thuê (Lịch sử thuê máy)</h2>
    </div>

    <!-- Nav tabs -->
    <ul class="nav nav-tabs mb-4" id="rentalTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="active-tab" data-bs-toggle="tab" data-bs-target="#active" type="button" role="tab" aria-selected="true">
                Đang Thuê <span class="badge bg-primary ms-1">@Model.ActiveRentals.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab" aria-selected="false">
                Chờ Duyệt <span class="badge bg-warning text-dark ms-1">@Model.PendingRentals.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab" aria-selected="false">
                Lịch Sử Cũ <span class="badge bg-secondary ms-1">@Model.CompletedRentals.Count</span>
            </button>
        </li>
    </ul>

    <!-- Tab content -->
    <div class="tab-content" id="rentalTabsContent">
        <!-- Đang Thuê -->
        <div class="tab-pane fade show active" id="active" role="tabpanel" aria-labelledby="active-tab">
            @await Html.PartialAsync("_RentalTablePartial", Model.ActiveRentals)
        </div>
        
        <!-- Chờ Duyệt -->
        <div class="tab-pane fade" id="pending" role="tabpanel" aria-labelledby="pending-tab">
            @await Html.PartialAsync("_RentalTablePartial", Model.PendingRentals)
        </div>

        <!-- Lịch Sử Cũ -->
        <div class="tab-pane fade" id="completed" role="tabpanel" aria-labelledby="completed-tab">
            @await Html.PartialAsync("_RentalTablePartial", Model.CompletedRentals)
        </div>
    </div>
</div>

@functions {
    public string TranslateStatus(TechShare.Enums.RentalStatus status)
    {
        return status switch
        {
            TechShare.Enums.RentalStatus.ChoDuyet => "Chờ duyệt",
            TechShare.Enums.RentalStatus.DaDuyet => "Đã duyệt",
            TechShare.Enums.RentalStatus.DangGiao => "Đang giao máy",
            TechShare.Enums.RentalStatus.DangThue => "Đang Thuê",
            TechShare.Enums.RentalStatus.ChoTra => "Chờ kiểm tra trả",
            TechShare.Enums.RentalStatus.HoanTat => "Hoàn Tất",
            TechShare.Enums.RentalStatus.DaHuy => "Đã Hủy",
            TechShare.Enums.RentalStatus.TranhChap => "Đang Tranh Chấp",
            _ => "Không xác định"
        };
    }

    public string GetStatusBadgeClass(TechShare.Enums.RentalStatus status)
    {
        return status switch
        {
            TechShare.Enums.RentalStatus.ChoDuyet => "bg-warning text-dark",
            TechShare.Enums.RentalStatus.DaDuyet => "bg-info text-dark",
            TechShare.Enums.RentalStatus.DangThue => "bg-primary",
            TechShare.Enums.RentalStatus.HoanTat => "bg-success",
            TechShare.Enums.RentalStatus.TranhChap => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
