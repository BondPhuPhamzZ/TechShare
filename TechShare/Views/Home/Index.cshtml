@model IEnumerable<TechShare.Models.Device>
@{
    ViewData["Title"] = "Trang Chủ";
}

<div class="px-4 py-5 my-5 text-center">
    <h1 class="display-5 fw-bold text-primary">TechShare B2C</h1>
    <div class="col-lg-6 mx-auto">
        <p class="lead mb-4">Dịch vụ cho thuê thiết bị công nghệ hàng đầu. Đa dạng các dòng Laptop, Máy ảnh, Phụ kiện với thủ tục nhanh gọn, giá cả hợp lý và chất lượng đảm bảo.</p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            <a asp-controller="Device" asp-action="Catalog" class="btn btn-primary btn-lg px-4 gap-3">Xem Danh Mục Sản Phẩm</a>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Thiết Bị Mới Nhất</h3>
        <a asp-controller="Device" asp-action="Catalog" class="text-decoration-none">Xem tất cả <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info text-center">Chưa có thiết bị nào.</div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <partial name="_DeviceCard" model="item" />
            }
        }
    </div>
    </div>
    
    <div class="text-center mt-5">
        <a asp-controller="Device" asp-action="Catalog" class="btn btn-outline-primary btn-lg px-5 fw-bold rounded-pill shadow-sm">Xem thêm tất cả thiết bị <i class="bi bi-arrow-right ms-2"></i></a>
    </div>
</div>
