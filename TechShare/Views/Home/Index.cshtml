@model IEnumerable<TechShare.Models.Device>
@{
    ViewData["Title"] = "Trang Chủ - Thuê Thiết Bị P2P";
}

<!-- Banner / Jumbotron -->
<div class="p-5 mb-4 bg-light rounded-3 text-center shadow-sm">
    <div class="container-fluid py-4">
        <h1 class="display-5 fw-bold text-primary">TechShare P2P</h1>
        <p class="col-md-8 mx-auto fs-5 mt-3">
            Nền tảng thuê thiết bị công nghệ (Laptop, Máy ảnh) uy tín dành cho Sinh viên. 
            Giải quyết triệt để rủi ro lừa đảo nhờ <strong>Hệ thống Đánh giá Uy tín</strong> và <strong>Chính sách Bảo vệ 2 giờ</strong>.
        </p>
        <div class="d-flex justify-content-center mt-4">
            <input type="text" class="form-control w-50 me-2" placeholder="Tìm kiếm máy ảnh, laptop, cáp sạc..." />
            <button class="btn btn-primary btn-lg" type="button">Tìm kiếm</button>
        </div>
    </div>
</div>

<div class="container mt-5">
    <h3 class="mb-4 fw-bold">Thiết Bị Mới Nhất</h3>
    
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <partial name="_DeviceCard" model="item" />
        }
    </div>
</div>
