@model TechShare.Models.Device
@inject TechShare.Data.TechShareDbContext _context
@using System.Security.Claims
@{
    ViewData["Title"] = Model.Name;

    bool isVerified = false;
    if (User.Identity.IsAuthenticated)
    {
        var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(userIdStr, out int userId))
        {
            var user = _context.Users.Find(userId);
            if (user != null) { isVerified = user.IsVerified; }
        }
    }
}

<div class="container mt-5">
    <div class="row">
        <!-- Cột Ảnh Thiết Bị -->
        <div class="col-md-7 mb-4">
            <div class="card border-0 shadow-sm">
                <img src="@Model.ImageUrl" class="card-img-top rounded" alt="@Model.Name" style="width: 100%; height: auto; max-height: 500px; object-fit: contain; background-color: #f8f9fa;">
            </div>
        </div>

        <!-- Cột Thông Tin & Form Đặt Cọc -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm p-4">
                <span class="badge bg-secondary mb-2" style="width: fit-content;">@Model.Category.Name</span>
                <h2 class="fw-bold text-primary mb-3">@Model.Name</h2>
                <p class="text-muted">@Model.Description</p>

                <hr />
                
                <div class="d-flex justify-content-between mb-2">
                    <span class="fs-5">Giá thuê:</span>
                    <strong class="text-dark fw-bold fs-4">@Model.PricePerDay.ToString("N0") VNĐ / Ngày</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="fs-5">Tiền cọc:</span>
                    <strong class="text-dark fw-bold fs-5">@Model.DepositAmount.ToString("N0") VNĐ</strong>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="fs-5">Kho còn:</span>
                    <strong class="text-success fs-5">@Model.StockQuantity cái</strong>
                </div>

                <hr />


                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger fw-bold shadow-sm">
                        <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <!-- Form giả lập hành động -->
                <form action="/Rental/Checkout" method="get">
                    <input type="hidden" name="deviceId" value="@Model.Id" />
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Từ ngày</label>
                            <input type="date" class="form-control" name="startDate" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Đến ngày</label>
                            <input type="date" class="form-control" name="endDate" required>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small text-muted">Số lượng thuê</label>
                        <input type="number" class="form-control" name="quantity" min="1" max="@Model.StockQuantity" value="1" required>
                    </div>
                    
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <a href="/Auth/Login" class="btn btn-primary w-100 py-2 fw-bold fs-6 shadow-sm">ĐĂNG NHẬP ĐỂ THUÊ THIẾT BỊ</a>
                    }
                    else if (!isVerified)
                    {
                        <div class="alert alert-warning border-warning shadow-sm">
                            <strong><i class="bi bi-shield-lock me-2"></i>Yêu cầu xác minh danh tính!</strong><br>
                            Bạn cần tải lên ảnh CCCD tại trang <a href="/Profile/Index" class="alert-link">Hồ sơ cá nhân</a> để có thể đặt thuê.
                        </div>
                        <button type="button" class="btn btn-secondary w-100 py-2 fw-bold fs-6 shadow-sm" disabled>
                            TÀI KHOẢN CHƯA XÁC MINH
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold fs-6 shadow-sm">
                            TIẾN HÀNH THUÊ VÀ ĐẶT CỌC
                        </button>
                    }
                </form>

            </div>
        </div>
    </div>

    <!-- KHU VỰC 3: LỊCH SỬ ĐÁNH GIÁ (REVIEW TỪ NGƯỜI THUÊ TRƯỚC) -->
    @{
        // Rút trích tất cả các đánh giá từ các đơn thuê của thiết bị này (Chỉ lấy đơn nào đã có Review)
        var allReviews = Model.Rentals.Where(r => r.Review != null).Select(r => r.Review).OrderByDescending(r => r.Id).ToList();
    }
    
    <div class="row mt-5">
        <div class="col-md-12">
            <h4 class="fw-bold mb-4">Lịch sử Đánh giá Thiết bị (@allReviews.Count đánh giá)</h4>
            
            @if (!allReviews.Any())
            {
                <div class="alert alert-light border">Chưa có đánh giá nào cho thiết bị này. Hãy là người đầu tiên trải nghiệm!</div>
            }
            else
            {
                <!-- Hiển thị 3 đánh giá mới nhất -->
                <div class="row g-3">
                    @foreach (var review in allReviews.Take(3))
                    {
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100 bg-light">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="fw-bold text-primary">@review.Reviewer.FullName</span>
                                        <span class="text-warning fw-bold">@(new string('⭐', review.Rating))</span>
                                    </div>
                                    <p class="text-muted small mb-0">"@review.Comment"</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Nút XEM THÊM (Chỉ hiện nếu có > 3 đánh giá) -->
                @if (allReviews.Count > 3)
                {
                    <div class="text-center mt-3">
                        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#moreReviews" aria-expanded="false" aria-controls="moreReviews">
                            Xem thêm @(allReviews.Count - 3) đánh giá
                        </button>
                    </div>

                    <!-- Vùng bị ẩn Collapse -->
                    <div class="collapse mt-3" id="moreReviews">
                        <div class="row g-3">
                            @foreach (var review in allReviews.Skip(3))
                            {
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm h-100 bg-light">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="fw-bold text-primary">@review.Reviewer.FullName</span>
                                                <span class="text-warning fw-bold">@(new string('⭐', review.Rating))</span>
                                            </div>
                                            <p class="text-muted small mb-0">"@review.Comment"</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>

</div>
