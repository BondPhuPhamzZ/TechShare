@model TechShare.Models.Device
@inject TechShare.Data.TechShareDbContext _context
@using System.Security.Claims
@{
    ViewData["Title"] = Model.Name;

    bool isVerified = false;
    if (User.Identity.IsAuthenticated)
    {
        var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(userIdStr, out int userId))
        {
            var user = _context.Users.Find(userId);
            if (user != null) { isVerified = user.IsVerified; }
        }
    }
}

<div class="container mt-5">
    <div class="row">
        <!-- Cột Ảnh Thiết Bị & Thumbnails -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 text-center" style="background-color: #fff;">
                <!-- Main Carousel -->
                <div id="deviceCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                    <div class="carousel-inner rounded-3 bg-light">
                        <div class="carousel-item active">
                            <img src="@Model.ImageUrl" class="d-block w-100 img-fluid" style="height: 350px; object-fit: contain;" alt="@Model.Name">
                        </div>
                        <div class="carousel-item">
                            <img src="@Model.ImageUrl" class="d-block w-100 img-fluid" style="height: 350px; object-fit: contain; filter: brightness(0.95);" alt="@Model.Name - Góc 2">
                        </div>
                        <div class="carousel-item">
                            <img src="@Model.ImageUrl" class="d-block w-100 img-fluid" style="height: 350px; object-fit: contain; filter: contrast(1.1);" alt="@Model.Name - Góc 3">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#deviceCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon bg-dark rounded-circle p-2 opacity-50" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#deviceCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon bg-dark rounded-circle p-2 opacity-50" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
                
                <!-- Thumbnails -->
                <div class="row g-2 justify-content-center">
                    <div class="col-4">
                        <div class="border rounded-3 p-2 bg-light thumb-item border-primary" data-bs-target="#deviceCarousel" data-bs-slide-to="0" style="cursor: pointer;">
                            <img src="@Model.ImageUrl" class="img-fluid" alt="Thumbnail 1" style="height: 60px; object-fit: contain;">
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded-3 p-2 bg-light thumb-item" data-bs-target="#deviceCarousel" data-bs-slide-to="1" style="cursor: pointer; filter: brightness(0.95);">
                            <img src="@Model.ImageUrl" class="img-fluid" alt="Thumbnail 2" style="height: 60px; object-fit: contain;">
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded-3 p-2 bg-light thumb-item" data-bs-target="#deviceCarousel" data-bs-slide-to="2" style="cursor: pointer; filter: contrast(1.1);">
                            <img src="@Model.ImageUrl" class="img-fluid" alt="Thumbnail 3" style="height: 60px; object-fit: contain;">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột Thông Tin, Specs Grid & Form Đặt Cọc -->
        <div class="col-md-6">
            <div class="p-2">
                <h2 class="fw-bold text-primary mb-2" style="font-size: 2.2rem;">@Model.Name</h2>
                
                <div class="d-flex align-items-center mb-3">
                    @{
                        var reviewsInfo = Model.Rentals?.Where(r => r.Review != null).Select(r => r.Review).ToList() ?? new List<TechShare.Models.Review>();
                        if (reviewsInfo.Any())
                        {
                            var avgRating = reviewsInfo.Average(r => r.Rating);
                            <span class="text-warning fs-5 me-2">
                                @(new string('⭐', (int)Math.Round(avgRating)))
                            </span> 
                            <span class="text-primary fs-5">@avgRating.ToString("0.0") (@reviewsInfo.Count)</span>
                        }
                    }
                </div>

                <div class="mb-4">
                    <strong class="text-primary fw-bold" style="font-size: 2rem;">@Model.PricePerDay.ToString("N0")Đ/ Ngày</strong>
                </div>

                <!-- Mô tả & Cấu hình -->
                <div class="mb-4 bg-light p-3 rounded-4 border-0 shadow-sm">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <h6 class="fw-bold text-dark mb-2">Mô tả thiết bị:</h6>
                        <p class="text-secondary mb-3" style="line-height: 1.6; white-space: pre-wrap;">@Model.Description</p>
                    }

                    @if (!string.IsNullOrEmpty(Model.Specifications))
                    {
                        <h6 class="fw-bold text-dark mb-2">Thông số kỹ thuật:</h6>
                        <ul class="list-unstyled text-secondary mb-0">
                            @{
                                var specsList = Model.Specifications.Split(new[] { ',', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                                foreach (var spec in specsList)
                                {
                                    <li class="mb-1"><i class="bi bi-check2-circle text-primary me-2"></i>@spec.Trim()</li>
                                }
                            }
                        </ul>
                    }
                    @if (string.IsNullOrEmpty(Model.Description) && string.IsNullOrEmpty(Model.Specifications))
                    {
                        <p class="text-muted fst-italic mb-0">Chưa có thông tin mô tả chi tiết cho thiết bị này.</p>
                    }
                </div>
                
                <p class="text-muted small mb-4">Tiền cọc: <strong class="text-dark">@Model.DepositAmount.ToString("N0") VNĐ</strong> - Kho còn: <strong class="text-dark">@Model.StockQuantity</strong></p>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger fw-bold shadow-sm">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <!-- Form Đặt Thuê -->
                <form asp-controller="Rental" asp-action="Checkout" method="get">
                    <input type="hidden" name="deviceId" value="@Model.Id" />
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Từ ngày</label>
                            <input type="date" class="form-control" name="startDate" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Đến ngày</label>
                            <input type="date" class="form-control" name="endDate" required>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small text-muted">Số lượng thuê</label>
                        <input type="number" class="form-control" name="quantity" min="1" max="@Model.StockQuantity" value="1" required>
                    </div>
                    
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary w-100 py-3 fw-bold fs-5 shadow-sm text-white border-0">ĐĂNG NHẬP ĐỂ THUÊ</a>
                    }
                    else if (!isVerified)
                    {
                        <div class="alert alert-warning border-warning shadow-sm">
                            <strong>Yêu cầu xác minh danh tính!</strong><br>
                            Bạn cần tải lên ảnh CCCD tại trang <a asp-controller="Profile" asp-action="Index" class="alert-link">Hồ sơ cá nhân</a> để có thể đặt thuê.
                        </div>
                        <button type="button" class="btn btn-secondary w-100 py-3 fw-bold fs-5 shadow-sm" disabled>
                            TÀI KHOẢN CHƯA XÁC MINH
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary w-100 py-3 fw-bold fs-5 shadow-sm text-white border-0">
                            Thuê ngay
                        </button>
                    }
                </form>
            </div>
        </div>
    </div>

    <!-- KHU VỰC 3: LỊCH SỬ ĐÁNH GIÁ (REVIEW TỪ NGƯỜI THUÊ TRƯỚC) -->
    @{
        // Rút trích tất cả các đánh giá từ các đơn thuê của thiết bị này (Chỉ lấy đơn nào đã có Review)
        var allReviews = Model.Rentals.Where(r => r.Review != null).Select(r => r.Review).OrderByDescending(r => r.Id).ToList();
    }
    
    <div class="row mt-5">
        <div class="col-md-12">
            <h4 class="fw-bold mb-4">Lịch sử Đánh giá Thiết bị (@allReviews.Count đánh giá)</h4>
            
            @if (!allReviews.Any())
            {
                <div class="alert alert-light border">Chưa có đánh giá nào cho thiết bị này. Hãy là người đầu tiên trải nghiệm!</div>
            }
            else
            {
                <!-- Hiển thị 3 đánh giá mới nhất -->
                <div class="row g-3">
                    @foreach (var review in allReviews.Take(3))
                    {
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100 bg-light">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="fw-bold text-primary">@review.Reviewer.FullName</span>
                                        <span class="text-warning fw-bold">@(new string('⭐', review.Rating))</span>
                                    </div>
                                    <p class="text-muted small mb-0">"@review.Comment"</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Nút XEM THÊM (Chỉ hiện nếu có > 3 đánh giá) -->
                @if (allReviews.Count > 3)
                {
                    <div class="text-center mt-3">
                        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#moreReviews" aria-expanded="false" aria-controls="moreReviews">
                            Xem thêm @(allReviews.Count - 3) đánh giá
                        </button>
                    </div>

                    <!-- Vùng bị ẩn Collapse -->
                    <div class="collapse mt-3" id="moreReviews">
                        <div class="row g-3">
                            @foreach (var review in allReviews.Skip(3))
                            {
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm h-100 bg-light">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="fw-bold text-primary">@review.Reviewer.FullName</span>
                                                <span class="text-warning fw-bold">@(new string('⭐', review.Rating))</span>
                                            </div>
                                            <p class="text-muted small mb-0">"@review.Comment"</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var carouselEl = document.getElementById('deviceCarousel');
            var thumbItems = document.querySelectorAll('.thumb-item');
            
            if (carouselEl && thumbItems.length > 0) {
                carouselEl.addEventListener('slide.bs.carousel', function (event) {
                    // Xóa border-primary ở tất cả thumb
                    thumbItems.forEach(function(el) {
                        el.classList.remove('border-primary');
                    });
                    // Thêm border-primary vào thumb tương ứng
                    if(thumbItems[event.to]) {
                        thumbItems[event.to].classList.add('border-primary');
                    }
                });
            }
        });
    </script>
}
