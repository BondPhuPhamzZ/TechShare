@model TechShare.Models.Device
@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    <!-- Nút trở về -->
    <a href="/" class="btn btn-outline-secondary mb-4">&larr; Trở về danh sách</a>

    <div class="row">
        <!-- Cột Ảnh Thiết Bị -->
        <div class="col-md-7 mb-4">
            <div class="card border-0 shadow-sm">
                <img src="@Model.ImageUrl" class="card-img-top rounded" alt="@Model.Name" style="width: 100%; height: auto; max-height: 500px; object-fit: contain; background-color: #f8f9fa;">
            </div>
        </div>

        <!-- Cột Thông Tin & Form Đặt Cọc -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm p-4">
                <span class="badge bg-secondary mb-2" style="width: fit-content;">@Model.Category.Name</span>
                <h2 class="fw-bold text-primary mb-3">@Model.Name</h2>
                <p class="text-muted">@Model.Description</p>

                <hr />
                
                <div class="d-flex justify-content-between mb-2">
                    <span class="fs-5">Giá thuê:</span>
                    <strong class="text-danger fs-4">@Model.PricePerDay.ToString("N0") VNĐ / Ngày</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="fs-5">Tiền cọc:</span>
                    <strong class="text-warning fs-5">@Model.DepositAmount.ToString("N0") VNĐ</strong>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="fs-5">Kho còn:</span>
                    <strong class="text-success fs-5">@Model.StockQuantity cái</strong>
                </div>

                <hr />

                <!-- Thông tin Chủ sở hữu -->
                <div class="bg-light p-3 rounded mb-4 border">
                    <p class="mb-1 text-muted small">THÔNG TIN CHỦ SỞ HỮU</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5">@Model.Owner.FullName</span>
                        <span class="badge bg-warning text-dark fs-6">⭐ @Model.Owner.ReputationScore.ToString("0.0")/5</span>
                    </div>
                </div>

                <!-- Form giả lập hành động -->
                <form action="/Rental/Checkout" method="get">
                    <input type="hidden" name="deviceId" value="@Model.Id" />
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Từ ngày</label>
                            <input type="date" class="form-control" name="startDate" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Đến ngày</label>
                            <input type="date" class="form-control" name="endDate" required>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small text-muted">Số lượng thuê</label>
                        <input type="number" class="form-control" name="quantity" min="1" max="@Model.StockQuantity" value="1" required>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 py-3 fw-bold fs-5 shadow">
                        TIẾN HÀNH THUÊ VÀ ĐẶT CỌC
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>
