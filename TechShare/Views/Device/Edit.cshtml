@model TechShare.ViewModels.DeviceCreateViewModel
@{
    ViewData["Title"] = "Chỉnh sửa Thiết Bị";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">Cập Nhật Thiết Bị</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên Thiết Bị</label>
                            <input asp-for="Name" class="form-control" placeholder="VD: Máy ảnh Sony A6000" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Danh Mục</label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Hình Ảnh Mới (Bỏ trống nếu giữ nguyên)</label>
                                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                                <span asp-validation-for="ImageFile" class="text-danger"></span>
                                @if (ViewBag.CurrentImageUrl != null)
                                {
                                    <div class="mt-2">
                                        <img src="@ViewBag.CurrentImageUrl" style="height: 50px; object-fit: cover;" class="rounded shadow-sm" />
                                    </div>
                                }
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Giá thuê (VNĐ/Ngày)</label>
                                <input asp-for="PricePerDay" type="number" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Tiền Cọc (VNĐ)</label>
                                <input asp-for="DepositAmount" type="number" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Số lượng máy</label>
                                <input asp-for="StockQuantity" type="number" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Mô tả thiết bị</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="d-flex justify-content-end">
                            <a asp-controller="Admin" asp-action="Devices" class="btn btn-secondary me-2">Hủy</a>
                            <button type="submit" class="btn btn-primary fw-bold px-4">Lưu Thay Đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
