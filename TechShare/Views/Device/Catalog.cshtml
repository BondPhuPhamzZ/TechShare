@model IEnumerable<TechShare.Models.Device>
@{
    ViewData["Title"] = "Danh Mục Thiết Bị";
}

<div class="bg-white py-3 shadow-sm mb-4">
    <div class="container">
        <form asp-controller="Device" asp-action="Catalog" method="get" class="d-flex justify-content-center">
            <input type="text" name="q" value="@ViewData["SearchQuery"]" class="form-control form-control-lg w-50 me-2" placeholder="Tìm kiếm máy ảnh, laptop, cáp sạc..." />
            
            @{
                var categories = ViewData["Categories"] as List<TechShare.Models.Category> ?? new List<TechShare.Models.Category>();
                int? currentCatId = ViewData["CategoryId"] as int?;
            }
            <select name="categoryId" class="form-select form-select-lg w-25 me-2">
                <option value="">Tất cả danh mục</option>
                @foreach (var cat in categories)
                {
                    if (currentCatId == cat.Id)
                    {
                        <option value="@cat.Id" selected>@cat.Name</option>
                    }
                    else
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>

            <button class="btn btn-primary btn-lg px-4 fw-bold" type="submit">Tìm kiếm</button>
        </form>
    </div>
</div>

<div class="container mt-4 mb-5">
    <h3 class="mb-4 fw-bold">Thiết Bị Nổi Bật</h3>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-warning text-center">
                    Không tìm thấy thiết bị nào phù hợp với yêu cầu của bạn.
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <partial name="_DeviceCard" model="item" />
            }
        }
        }
    </div>

    @if (ViewData["TotalPages"] != null && (int)ViewData["TotalPages"] > 1)
    {
        int currentPage = (int)ViewData["CurrentPage"];
        int totalPages = (int)ViewData["TotalPages"];
        string q = ViewData["SearchQuery"] as string;
        int? catId = ViewData["CategoryId"] as int?;

        <nav aria-label="Page navigation" class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Catalog" asp-route-q="@q" asp-route-categoryId="@catId" asp-route-page="@(currentPage - 1)">Trước</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Catalog" asp-route-q="@q" asp-route-categoryId="@catId" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Catalog" asp-route-q="@q" asp-route-categoryId="@catId" asp-route-page="@(currentPage + 1)">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>