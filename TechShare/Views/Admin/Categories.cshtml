@model IEnumerable<TechShare.Models.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Danh sách Danh Mục</h5>
        <button class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Thêm mới</button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Tên Danh Mục</th>
                        <th>Số Thiết Bị</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td><strong>@item.Name</strong></td>
                                <td><span class="badge bg-secondary">@(item.Devices?.Count ?? 0) thiết bị</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Sửa</button>
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Xóa</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Chưa có danh mục nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
