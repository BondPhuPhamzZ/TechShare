@model IEnumerable<TechShare.Models.Rental>
@{
    ViewData["Title"] = "Bảng điều khiển chung";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4 g-4">
    <div class="col-md-3">
        <div class="card bg-white shadow-sm border-0 border-start border-primary border-4 h-100 rounded-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted mb-1 fs-6">Doanh thu</h6>
                        <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalRevenue.ToString("N0") đ</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bi bi-wallet2 text-primary fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <a asp-action="Orders" class="text-decoration-none">
            <div class="card bg-white shadow-sm border-0 border-start border-primary border-4 h-100 position-relative hover-shadow transition-all rounded-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase text-muted mb-1 fs-6">Đơn cho thuê</h6>
                            <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalOrders</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-cart-check text-primary fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <div class="card bg-white shadow-sm border-0 border-start border-primary border-4 h-100 rounded-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted mb-1 fs-6">Tổng thiết bị</h6>
                        <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalDevices</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bi bi-laptop text-primary fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-white shadow-sm border-0 border-start border-primary border-4 h-100 rounded-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted mb-1 fs-6">Khách hàng</h6>
                        <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalUsers</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center">
                        <i class="bi bi-people text-primary fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

