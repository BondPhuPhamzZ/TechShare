@model IEnumerable<TechShare.Models.Rental>
@{
    ViewData["Title"] = "Quản lý Đơn thuê";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Danh sách Đơn Thuê</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Khách Hàng</th>
                        <th>Thiết Bị</th>
                        <th>Thời Gian Thuê</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@item.Id</span></td>
                                <td>
                                    <strong>@item.Renter.FullName</strong><br/>
                                    <small class="text-muted">@item.Renter.PhoneNumber</small>
                                </td>
                                <td>@item.Device.Name</td>
                                <td>
                                    @item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")<br/>
                                    <small class="text-muted">(@((item.EndDate - item.StartDate).Days) ngày)</small>
                                </td>
                                <td>
                                    <span class="text-danger fw-bold">@item.TotalPrice.ToString("N0") đ</span><br/>
                                    <small class="text-muted">Cọc: @item.Device.DepositAmount.ToString("N0") đ</small>
                                </td>
                                <td>
                                    @if (item.Status == TechShare.Enums.RentalStatus.ChoDuyet)
                                    {
                                        <span class="badge bg-warning text-dark">Chờ Duyệt</span>
                                    }
                                    else if (item.DepositStatus == TechShare.Enums.DepositStatus.DaThanhToan && item.Status == TechShare.Enums.RentalStatus.ChoDuyet)
                                    {
                                        <span class="badge bg-info text-dark">Đã Cọc</span>
                                    }
                                    else if (item.Status == TechShare.Enums.RentalStatus.DaDuyet)
                                    {
                                        <span class="badge bg-primary">Đã Duyệt</span>
                                    }
                                    else if (item.Status == TechShare.Enums.RentalStatus.DangThue)
                                    {
                                        <span class="badge bg-success">Đang Thuê</span>
                                    }
                                    else if (item.Status == TechShare.Enums.RentalStatus.HoanTat)
                                    {
                                        <span class="badge bg-dark">Hoàn Tất</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Đã Hủy</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="UpdateOrderStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        @if (item.Status == TechShare.Enums.RentalStatus.ChoDuyet)
                                        {
                                            <button type="submit" name="newStatus" value="@TechShare.Enums.RentalStatus.DaDuyet" class="btn btn-sm btn-success fw-bold me-1">Duyệt Đơn</button>
                                            <button type="submit" name="newStatus" value="@TechShare.Enums.RentalStatus.DaHuy" class="btn btn-sm btn-outline-danger fw-bold" onclick="return confirm('Bạn có chắc chắn muốn Từ chối đơn này?');">Từ Chối</button>
                                        }
                                        else if (item.Status == TechShare.Enums.RentalStatus.DaDuyet)
                                        {
                                            if (item.DeliveryMethod == TechShare.Enums.DeliveryMethod.GiaoTanNoi)
                                            {
                                                <button type="submit" name="newStatus" value="@TechShare.Enums.RentalStatus.DangGiao" class="btn btn-sm btn-info fw-bold text-dark me-1">Giao Máy (Shipper)</button>
                                            }
                                            else // Tự lấy
                                            {
                                                <button type="submit" name="newStatus" value="@TechShare.Enums.RentalStatus.DangThue" class="btn btn-sm btn-primary fw-bold text-white" onclick="return confirm('Khách đã đến lấy máy tại cửa hàng?');">Khách đã nhận</button>
                                            }
                                        }
                                        else if (item.Status == TechShare.Enums.RentalStatus.DangGiao)
                                        {
                                            <button type="submit" name="newStatus" value="@TechShare.Enums.RentalStatus.DangThue" class="btn btn-sm btn-primary fw-bold text-white" onclick="return confirm('Xác nhận Shipper đã giao thành công cho khách?');">Đã giao tới tay khách</button>
                                        }
                                        else if (item.Status == TechShare.Enums.RentalStatus.DangThue || item.Status == TechShare.Enums.RentalStatus.ChoTra || item.Status == TechShare.Enums.RentalStatus.TranhChap)
                                        {
                                            <button type="submit" name="newStatus" value="@TechShare.Enums.RentalStatus.HoanTat" class="btn btn-sm btn-dark fw-bold">Xác nhận Trả (Hoàn Tất)</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có đơn thuê nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
