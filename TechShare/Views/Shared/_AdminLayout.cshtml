<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .sidebar {
            min-height: 100vh;
            background-color: #343a40;
        }
        .sidebar a {
            color: #adb5bd;
            text-decoration: none;
            padding: 15px 20px;
            display: block;
            border-bottom: 1px solid #495057;
        }
        .sidebar a:hover, .sidebar a.active {
            background-color: #495057;
            color: #fff;
        }
        .main-content {
            padding: 20px;
        }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Desktop Sidebar (Fixed) -->
            <div class="col-md-2 sidebar d-none d-md-flex flex-column shadow p-0" style="position: fixed; top: 0; bottom: 0; left: 0; z-index: 1040; height: 100vh; overflow-y: auto;">
                <div class="text-center p-3 text-white border-bottom border-secondary">
                    <h4 class="fw-bold mb-0 text-primary">TECHSHARE</h4>
                    <small>Admin Dashboard</small>
                </div>
                <div class="mt-3 flex-grow-1">
                    <a asp-controller="Admin" asp-action="Index" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"> Bảng điều khiển</a>
                    <a asp-controller="Admin" asp-action="Orders" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "active" : "")"> Quản lý Đơn thuê</a>
                    <a asp-controller="Admin" asp-action="Devices" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Devices" ? "active" : "")"> Quản lý Thiết bị</a>
                    <a asp-controller="Admin" asp-action="Categories" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Categories" ? "active" : "")"> Quản lý Danh mục</a>
                    <a asp-controller="Admin" asp-action="Users" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")"> Quản lý Khách hàng</a>
                    <a asp-controller="Admin" asp-action="Reviews" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Reviews" ? "active" : "")"> Quản lý Đánh giá</a>
                </div>
                <div class="mt-auto w-100">
                    <a asp-controller="Home" asp-action="Index" class="bg-primary text-white"> Thoát về Trang chủ</a>
                </div>
            </div>

            <!-- Mobile Offcanvas Sidebar -->
            <div class="offcanvas offcanvas-start sidebar" tabindex="-1" id="mobileSidebar">
                <div class="offcanvas-header text-white border-bottom border-secondary">
                    <h4 class="fw-bold mb-0 text-primary">TECHSHARE</h4>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body d-flex flex-column p-0">
                    <div class="flex-grow-1 mt-3">
                        <a asp-controller="Admin" asp-action="Index"> Bảng điều khiển</a>
                        <a asp-controller="Admin" asp-action="Orders"> Quản lý Đơn thuê</a>
                        <a asp-controller="Admin" asp-action="Devices"> Quản lý Thiết bị</a>
                        <a asp-controller="Admin" asp-action="Categories"> Quản lý Danh mục</a>
                        <a asp-controller="Admin" asp-action="Users"> Quản lý Khách hàng</a>
                        <a asp-controller="Admin" asp-action="Reviews"> Quản lý Đánh giá</a>
                    </div>
                    <div class="mt-auto w-100">
                        <a asp-controller="Home" asp-action="Index" class="bg-primary text-white"> Thoát về Trang chủ</a>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 offset-md-2">
                <!-- Topbar -->
                <div class="bg-white p-3 shadow-sm d-flex justify-content-between align-items-center mb-4 sticky-top z-1">
                    <div class="d-flex align-items-center">
                        <!-- Hamburger button for Mobile -->
                        <button class="btn btn-outline-secondary d-md-none me-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <h5 class="mb-0 text-muted d-none d-sm-block">@ViewData["Title"]</h5>
                    </div>
                    <div>
                        <span class="me-3 fw-bold d-none d-sm-inline">Xin chào, Admin @User.Identity.Name</span>
                        <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-outline-primary">Đăng xuất</a>
                    </div>
                </div>

                <!-- Page Content -->
                <div class="main-content">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
