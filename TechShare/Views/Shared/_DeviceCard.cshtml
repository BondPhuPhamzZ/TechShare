@model TechShare.Models.Device

<div class="col">
    <div class="card h-100 shadow-sm border-0 bg-white device-card-hover position-relative">
        <!-- Ảnh thiết bị -->
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="height: 220px; object-fit: contain; background-color: #f8f9fa; padding: 10px;" />
        
        <div class="card-body d-flex flex-column">
            <h5 class="card-title fw-bold text-truncate mb-2" title="@Model.Name">
                <a asp-controller="Device" asp-action="Detail" asp-route-id="@Model.Id" class="stretched-link text-decoration-none text-dark">
                    @Model.Name
                </a>
            </h5>
            
            <div class="mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-danger fw-bold fs-6">@Model.PricePerDay.ToString("N0") đ/Ngày</span>
                </div>
                
                <div class="d-flex justify-content-between align-items-center">
                    <div class="small">
                        @{
                            var reviews = Model.Rentals?.Where(r => r.Review != null).Select(r => r.Review).ToList() ?? new List<TechShare.Models.Review>();
                            if (reviews.Any())
                            {
                                var avgRating = reviews.Average(r => r.Rating);
                                <span class="text-warning fw-bold">⭐ @avgRating.ToString("0.0")</span> <span class="text-muted" style="font-size: 0.8rem;">(@reviews.Count)</span>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
