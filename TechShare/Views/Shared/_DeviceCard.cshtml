@model TechShare.Models.Device

<div class="col">
    <div class="card h-100 shadow-sm border-0 bg-white">
        <!-- Ảnh thiết bị -->
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="height: 250px; object-fit: cover;" />
        
        <div class="card-body">
            <span class="badge bg-secondary mb-2">@Model.Category.Name</span>
            <h5 class="card-title fw-bold text-truncate" title="@Model.Name">@Model.Name</h5>
            
            <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="text-danger fw-bold fs-5">@Model.PricePerDay.ToString("N0") đ/Ngày</span>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div class="small">
                    @{
                        // Lấy danh sách review từ Rentals của Device này
                        var reviews = Model.Rentals?.Where(r => r.Review != null).Select(r => r.Review).ToList() ?? new List<TechShare.Models.Review>();
                        if (reviews.Any())
                        {
                            var avgRating = reviews.Average(r => r.Rating);
                            <span class="text-warning fw-bold">⭐ @avgRating.ToString("0.0")</span> <span class="text-muted">(@reviews.Count)</span>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Chưa có đánh giá</span>
                        }
                    }
                </div>
                <span class="text-muted small">Kho: <strong class="text-success">@Model.StockQuantity</strong> cái</span>
            </div>
        </div>
        
        <div class="card-footer bg-white border-top-0 pt-0">
            <hr />
            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="Device" asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm px-3 w-100">Xem chi tiết</a>
            </div>
        </div>
    </div>
</div>
