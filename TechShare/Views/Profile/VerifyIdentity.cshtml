@{
    ViewData["Title"] = "Xác Thực Định Danh";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h5 class="mb-0 fw-bold">Xác Thực Danh Tính (KYC)</h5>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-shield-check text-success" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-2">Bảo mật giao dịch bằng việc cung cấp thông tin Căn Cước Công Dân.</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <div asp-validation-summary="All"></div>
                        </div>
                    }

                    <form asp-action="VerifyIdentity" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Số Căn Cước Công Dân (12 số)</label>
                            <input type="text" name="idCardNumber" class="form-control form-control-lg" placeholder="Nhập 12 số CCCD" required pattern="\d{12}" title="Vui lòng nhập đúng 12 chữ số" maxlength="12" />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">Xác Thực Tự Động</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
