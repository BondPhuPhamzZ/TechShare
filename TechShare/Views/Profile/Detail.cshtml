@model TechShare.Models.User

@{
    ViewData["Title"] = "Hồ sơ của " + Model.FullName;
    var reviews = ViewBag.Reviews as List<TechShare.Models.Review>;
}

<div class="container mt-5 mb-5">
    <!-- Header Thông tin User -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body text-center p-5">
            <img src="https://ui-avatars.com/api/?name=@Model.FullName&background=random&size=150" class="rounded-circle mb-3 shadow" alt="Avatar" style="width: 120px; height: 120px;">
            <h3 class="fw-bold mb-1">
                @Model.FullName
                @if (Model.IsVerified)
                {
                    <i class="bi bi-patch-check-fill text-primary" title="Đã xác thực CCCD"></i>
                }
            </h3>
            <p class="text-muted mb-2">Thành viên từ: @Model.CreatedAt.ToString("MM/yyyy")</p>
            <div class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">
                ⭐ Uy tín: @Model.ReputationScore.ToString("0.0") / 5.0
            </div>
        </div>
    </div>

    <!-- Danh sách thiết bị đang cho thuê -->
    <h5 class="fw-bold mb-3">Đang cho thuê (@Model.Devices.Count)</h5>
    <div class="row mb-5">
        @if (!Model.Devices.Any())
        {
            <div class="col-12"><p class="text-muted">Chưa có thiết bị nào được đăng.</p></div>
        }
        else
        {
            foreach (var device in Model.Devices)
            {
                <div class="col-md-3 mb-3">
                    <div class="card h-100 shadow-sm">
                        <img src="@device.ImageUrl" class="card-img-top" style="height: 150px; object-fit: cover;" alt="@device.Name">
                        <div class="card-body p-3">
                            <h6 class="fw-bold mb-1 text-truncate">@device.Name</h6>
                            <p class="text-danger fw-bold mb-0">@device.PricePerDay.ToString("N0") đ/ngày</p>
                            <a asp-controller="Device" asp-action="Detail" asp-route-id="@device.Id" class="stretched-link"></a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Danh sách đánh giá -->
    <h5 class="fw-bold mb-3">Đánh giá từ cộng đồng (@reviews?.Count)</h5>
    @if (reviews == null || !reviews.Any())
    {
        <p class="text-muted">Chưa có đánh giá nào.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var review in reviews)
            {
                <div class="list-group-item border-0 shadow-sm mb-2 rounded p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="fw-bold text-primary">@review.Reviewer.FullName</div>
                        <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy")</small>
                    </div>
                    <div class="text-warning mb-2">
                        @for (int i = 0; i < review.Rating; i++)
                        {
                            <span>★</span>
                        }
                        @for (int i = review.Rating; i < 5; i++)
                        {
                            <span class="text-secondary">★</span>
                        }
                    </div>
                    <p class="mb-0">@review.Comment</p>
                </div>
            }
        </div>
    }
</div>
