@model TechShare.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm border-0 text-center p-4">
                <img src="https://ui-avatars.com/api/?name=@Model.UserInfo.FullName&background=random&size=150" class="rounded-circle mx-auto mb-3 shadow" alt="Avatar" style="width: 150px;">
                <h4 class="fw-bold mb-1">
                    @Model.UserInfo.FullName
                </h4>
                <p class="text-muted mb-2">@Model.UserInfo.Email</p>

                <hr />
                <div class="px-3">
                    <div class="d-flex justify-content-between mb-2">
                        <small class="text-muted">Số điện thoại:</small> 
                        <strong class="text-dark">@Model.UserInfo.PhoneNumber</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-4">
                        <small class="text-muted">Ngày tham gia:</small> 
                        <strong class="text-dark">@Model.UserInfo.CreatedAt.ToString("dd/MM/yyyy")</strong>
                    </div>
                </div>
                
                <div class="d-grid gap-2">
                    <a asp-action="EditProfile" class="btn btn-primary fw-bold">Sửa hồ sơ</a>
                    <a asp-action="ChangePassword" class="btn btn-outline-primary fw-bold">Đổi mật khẩu</a>
                </div>
            </div>
            
            <div class="alert alert-info mt-4 text-center">
                <i class="bi bi-info-circle"></i> Để theo dõi các thiết bị đang thuê, vui lòng vào <strong>Đơn Đi Thuê</strong>.
            </div>
        </div>
    </div>
</div>
