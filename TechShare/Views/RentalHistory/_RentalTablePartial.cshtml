@model IEnumerable<TechShare.Models.Rental>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Đơn</th>
                        <th>Thiết bị</th>
                        <th>Chủ máy</th>
                        <th>Ngày mượn - Ngày trả</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">Không có đơn nào trong mục này.</td></tr>
                    }
                    else
                    {
                        @foreach (var rental in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@rental.Id</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@rental.Device.ImageUrl" style="width: 50px; height: 50px; object-fit: cover;" class="rounded me-3" />
                                        <div>
                                            <a asp-controller="Device" asp-action="Detail" asp-route-id="@rental.Device.Id" class="fw-bold text-decoration-none">@rental.Device.Name</a>
                                        </div>
                                    </div>
                                </td>
                                <td><a asp-controller="Profile" asp-action="Detail" asp-route-id="@rental.Device.OwnerId" class="fw-bold text-dark text-decoration-none">@rental.Device.Owner.FullName</a></td>
                                <td>
                                    <div>@rental.StartDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-danger fw-bold">@rental.EndDate.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <span class="badge @(GetBadge(rental.Status))">@(GetStatus(rental.Status))</span>
                                </td>
                                <td class="text-end">
                                    @if (rental.Status == TechShare.Enums.RentalStatus.DangCheck)
                                    {
                                        <form asp-controller="RentalHistory" asp-action="ConfirmHandover" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@rental.Id" />
                                            <button type="submit" class="btn btn-sm btn-primary">Đã nhận máy (Bắt đầu 2H test)</button>
                                        </form>
                                    }
                                    else if (rental.Status == TechShare.Enums.RentalStatus.DangThue)
                                    {
                                        <form asp-controller="RentalHistory" asp-action="ReportIssue" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@rental.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn phát hiện máy có lỗi? Đơn sẽ bị khóa.')">Báo Lỗi</button>
                                        </form>
                                        <form asp-controller="RentalHistory" asp-action="ReturnDevice" method="post" class="d-inline ms-1">
                                            <input type="hidden" name="id" value="@rental.Id" />
                                            <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Xác nhận trả máy lại cho Chủ?')">Trả Máy</button>
                                        </form>
                                    }
                                    else if (rental.Status == TechShare.Enums.RentalStatus.HoanTat)
                                    {
                                        if (!rental.IsReviewed)
                                        {
                                            <a asp-controller="Review" asp-action="Create" asp-route-rentalId="@rental.Id" class="btn btn-sm btn-outline-warning">Đánh giá Chủ Máy</a>
                                        }
                                        else
                                        {
                                            <span class="btn btn-sm btn-secondary disabled">Đã đánh giá</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    public string GetStatus(TechShare.Enums.RentalStatus status)
    {
        return status switch
        {
            TechShare.Enums.RentalStatus.ChoDuyet => "Chờ duyệt",
            TechShare.Enums.RentalStatus.ChoGiao => "Chờ Giao Máy",
            TechShare.Enums.RentalStatus.DangCheck => "Khách đang check",
            TechShare.Enums.RentalStatus.DangThue => "Đang Thuê",
            TechShare.Enums.RentalStatus.ChoTra => "Chờ kiểm tra trả",
            TechShare.Enums.RentalStatus.HoanTat => "Hoàn Tất",
            TechShare.Enums.RentalStatus.DaHuy => "Đã Hủy",
            TechShare.Enums.RentalStatus.TranhChap => "Đang Tranh Chấp",
            _ => "Không xác định"
        };
    }

    public string GetBadge(TechShare.Enums.RentalStatus status)
    {
        return status switch
        {
            TechShare.Enums.RentalStatus.ChoDuyet => "bg-warning text-dark",
            TechShare.Enums.RentalStatus.ChoGiao => "bg-info text-dark",
            TechShare.Enums.RentalStatus.DangThue => "bg-primary",
            TechShare.Enums.RentalStatus.HoanTat => "bg-success",
            TechShare.Enums.RentalStatus.TranhChap => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
