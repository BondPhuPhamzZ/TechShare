@model TechShare.Models.Rental
@{
    ViewData["Title"] = "Thuê Thành Công";
}

<div class="container mt-5 text-center">
    <div class="card border-0 shadow-sm p-5 mx-auto" style="max-width: 600px;">
        <div class="text-success mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
              <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
        </div>
        <h2 class="fw-bold text-success">Gửi Yêu Cầu Thuê Thành Công!</h2>
        <p class="text-muted mt-3">
            Đơn thuê <strong>@Model.Device.Name</strong> của bạn đã được ghi nhận an toàn vào hệ thống.
        </p>
        
        <div class="bg-light p-4 rounded text-start mb-4 border">
            <h5 class="fw-bold border-bottom pb-2 mb-3">Thông Tin Đơn Hàng</h5>
            <p class="mb-1">Mã đơn thuê (Rental ID): <strong>#@Model.Id</strong></p>
            <p class="mb-1">Tiền cọc hệ thống đang giữ: <strong class="text-warning">@Model.Device.DepositAmount.ToString("N0") VNĐ</strong></p>
            <p class="mb-0 text-danger fw-bold mt-2">Trạng thái: Chờ chủ máy xác nhận (Pending)</p>
        </div>
        
        <div class="alert alert-info small text-start">
            <strong>Chính sách Bảo vệ 2 Giờ:</strong> Khi chủ máy giao thiết bị cho bạn, hệ thống sẽ kích hoạt bộ đếm ngược. Bạn có đúng 2 tiếng để báo lỗi nếu thiết bị không đúng mô tả. Qua 2 tiếng, tiền cọc sẽ được bảo vệ cho chủ máy.
        </div>
        
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4 me-2">Về Trang chủ</a>
            <a asp-controller="Order" asp-action="Index" class="btn btn-primary px-4">Quản lý Đơn Thuê</a>
        </div>
    </div>
</div>
